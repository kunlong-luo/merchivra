# For local development only. Copy to .env and change before running.
MERCHIVRA_DB_PASSWORD=please_change_this_before_start

# No default admin credentials. Set both values manually for a first local login.
# Password must contain >=16 characters; choose a random unique value.
MERCHIVRA_BOOTSTRAP_USERNAME=
MERCHIVRA_BOOTSTRAP_PASSWORD=
MERCHIVRA_BOOTSTRAP_TENANT_NAME=Merchivra Workspace

# Real SP-API/OAuth off by default. Never paste actual credentials into Git.
# In production use a secret manager, dedicated HTTPS deployment, Demo disabled.
MERCHIVRA_SPAPI_ENABLED=false
MERCHIVRA_SPAPI_SANDBOX=true
MERCHIVRA_SPAPI_ALLOW_WRITES=false
MERCHIVRA_SPAPI_OAUTH_ENABLED=false
# MERCHIVRA_SPAPI_APP_ID=
# MERCHIVRA_SPAPI_OAUTH_REDIRECT_URI=
# MERCHIVRA_SPAPI_OAUTH_AMAZON_ORIGINS=https://amazon.com
# MERCHIVRA_SPAPI_OAUTH_ENCRYPTION_KEY_BASE64=
# MERCHIVRA_LWA_CLIENT_ID=
# MERCHIVRA_LWA_CLIENT_SECRET=

# Optional: live-only Sellers v1 Marketplace verification. Never enable in Demo/sandbox.
MERCHIVRA_SPAPI_VERIFICATION_ENABLED=false

# V9: local AES key rewrap is not Amazon OAuth/LWA Refresh Token renewal.
# Choose either the legacy encryption key OR keyring; never both.
# MERCHIVRA_SPAPI_OAUTH_ENCRYPTION_KEYRING=1:<base64-key-v1>,2:<base64-key-v2>
# MERCHIVRA_SPAPI_OAUTH_ACTIVE_KEY_VERSION=1
# Inject actual keys with a Secret Manager; never store secrets in repository files.

# V10 advisory operations automation: never calls Amazon, makes no business writes.
# Enable in disposable staging first; manual scan always works.
MERCHIVRA_OPS_SCHEDULER_ENABLED=false
MERCHIVRA_OPS_SCAN_INTERVAL_MS=900000
MERCHIVRA_OPS_LOW_STOCK_THRESHOLD=3

# V11A Orders worker: ONLY fixed synthetic localhost Demo source.
# Do NOT enable on production, never combine with actual SP-API egress.
MERCHIVRA_ORDERS_SYNC_ENABLED=false
MERCHIVRA_ORDERS_SYNC_SCHEDULER_ENABLED=false
MERCHIVRA_ORDERS_SYNC_SCHEDULER_MS=30000
