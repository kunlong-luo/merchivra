{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "plugins": [{"name":"next"}],
    "types": ["node","react","react-dom"],
    "incremental": true,
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "src/main.tsx"]
}
