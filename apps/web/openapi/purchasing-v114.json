    "/api/v1/purchasing/suppliers": {
      "post": {
        "operationId": "createLocalSupplier",
        "summary": "Create tenant ACTIVE supplier",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewLocalSupplier"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tenant-scoped mutation result; CSRF and role checked by server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Supplier"
                }
              }
            }
          },
          "400": {
            "description": "Validation rejected, no mutation committed"
          },
          "401": {
            "description": "Login required"
          },
          "403": {
            "description": "Insufficient role or CSRF"
          },
          "404": {
            "description": "Tenant-scoped resource missing"
          },
          "409": {
            "description": "State, balance, idempotency, concurrency, or approval conflict"
          }
        }
      }
    },
