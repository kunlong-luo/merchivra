  "openapi": "3.1.0",
  "info": {
    "title": "Merchivra local purchasing read pages",
    "version": "115.1.0",
    "description": "Tenant-scoped core purchasing reads and authenticated CSRF-protected local writes; no Amazon LIVE remote writes. APIs always recheck permissions, status, balance, currency and transaction safety on server."
