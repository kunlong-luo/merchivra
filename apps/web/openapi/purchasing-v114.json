        "summary": "Batch resolve up to 100 tenant-owned historical warehouse IDs, including archived labels",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": false,
            "schema": {
              "type": "array",
