{
  "name": "@merchivra/web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "api:generate": "orval --config orval.config.ts",
    "api:generate:fba": "orval --config orval.fba.config.ts",
    "api:generate:ads": "orval --config orval.ads.config.ts",
    "api:generate:ops": "orval --config orval.ops.config.ts",
    "api:check": "npm run api:generate && node ../../scripts/check-orval-generated.mjs",
    "dev:next": "next dev --hostname 127.0.0.1 --port 3001",
    "build:next": "next build",
    "start:next": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck:next": "tsc --noEmit --project tsconfig.next.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "next": "16.4.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "orval": "8.44.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "@types/node": "^24.0.0"
  }
}
