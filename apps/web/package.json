{
  "name": "@merchivra/web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "next start --hostname 127.0.0.1 --port 3000",
    "api:generate": "orval --config orval.config.ts && pnpm run api:generate:purchasing && pnpm run api:generate:manual-cost",
    "api:generate:fba": "orval --config orval.fba.config.ts",
    "api:generate:ads": "orval --config orval.ads.config.ts",
    "api:generate:ops": "orval --config orval.ops.config.ts",
    "api:check": "pnpm run api:generate && node ../../scripts/check-orval-generated.mjs",
    "dev:local": "MERCHIVRA_API_INTERNAL_URL=http://127.0.0.1:8081 next dev --hostname 127.0.0.1 --port 3001",
    "predev:local": "node scripts/ensure-purchasing-generated.mjs",
    "dev:next": "next dev --hostname 127.0.0.1 --port 3001",
    "build:next": "next build",
    "start:next": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck:next": "tsc --noEmit --project tsconfig.next.json",
    "predev": "node scripts/ensure-purchasing-generated.mjs",
    "pretest": "node scripts/ensure-purchasing-generated.mjs",
    "pretypecheck": "node scripts/ensure-purchasing-generated.mjs",
    "prebuild": "node scripts/ensure-purchasing-generated.mjs",
    "predev:next": "node scripts/ensure-purchasing-generated.mjs",
    "pretypecheck:next": "node scripts/ensure-purchasing-generated.mjs",
    "prebuild:next": "node scripts/ensure-purchasing-generated.mjs",
    "api:generate:purchasing": "orval --config orval.purchasing.config.ts",
    "dev:vite": "vite --host 127.0.0.1",
    "build:vite": "tsc --noEmit && vite build",
    "preview:vite": "vite preview --host 127.0.0.1",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "predev:vite": "node scripts/ensure-purchasing-generated.mjs",
    "prebuild:vite": "node scripts/ensure-purchasing-generated.mjs",
    "api:generate:manual-cost": "orval --config orval.manual-cost.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "8.21.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "next": "16.4.5",
    "lucide-react": "1.70.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "orval": "8.44.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "@types/node": "^24.0.0"
  },
  "packageManager": "pnpm@12.20.0"
}
