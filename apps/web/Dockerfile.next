# V122: opt-in private Next 16 standalone Node runtime. Existing Vite/Nginx
# Dockerfile remains the safe, separately selectable rollback path.
FROM node:24-alpine AS deps
WORKDIR /workspace/apps/web
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM deps AS build
WORKDIR /workspace/apps/web
COPY . .
# Next rewrites are compiled during build. This MUST be the private Compose
# service address, never a public URL or anything client-exposed.
ARG MERCHIVRA_API_INTERNAL_URL=http://server:8080
ENV MERCHIVRA_API_INTERNAL_URL=${MERCHIVRA_API_INTERNAL_URL}
RUN npm run build:next

FROM node:24-alpine AS runtime
ENV NODE_ENV=production \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /workspace
RUN addgroup -S nextjs && adduser -S -G nextjs nextjs
COPY --from=build --chown=nextjs:nextjs /workspace/apps/web/.next/standalone ./
COPY --from=build --chown=nextjs:nextjs /workspace/apps/web/.next/static ./apps/web/.next/static
WORKDIR /workspace/apps/web
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
