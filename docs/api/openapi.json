  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "DEC-09 尚未决定。仅候选机制，正式可能采用 Cookie Session/OIDC。"
      }
    },
    "schemas": {
      "Money": {
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^-?\\d+(?:\\.\\d{1,6})?$",
            "examples": [
              "40.00"
            ]
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "examples": [
              "USD"
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "meta"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            }
          },
          "meta": {
            "type": "object",
            "required": [
              "requestId"
            ],
            "properties": {
              "requestId": {
                "type": "string"
              }
            }
          }
        }
      },
      "CurrentMember": {
        "type": "object",
        "required": [
          "id",
          "activeTenantId",
          "roles"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "activeTenantId": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "accountScopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SellerAccount": {
        "type": "object",
        "required": [
          "id",
          "sellerId",
          "region",
          "connectionStatus"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sellerId": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "enum": [
              "NA",
              "EU",
              "FE"
            ]
          },
          "connectionStatus": {
            "type": "string",
            "enum": [
              "UNCONFIGURED",
              "AUTHORIZING",
              "CONNECTED",
              "AUTH_REQUIRED",
              "INSUFFICIENT_ROLE",
              "DEGRADED"
            ]
          }
        }
      },
      "SellerAccountCreate": {
        "type": "object",
        "required": [
          "sellerId",
          "region"
        ],
        "additionalProperties": false,
        "properties": {
          "sellerId": {
            "type": "string"
          },
          "region": {
            "type": "string",
            "enum": [
              "NA",
              "EU",
              "FE"
            ]
          }
        }
      },
      "Listing": {
        "type": "object",
        "required": [
          "id",
          "marketplaceId",
          "sellerSku",
          "mappingStatus"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "marketplaceId": {
            "type": "string"
          },
          "sellerSku": {
            "type": "string"
          },
          "asin": {
            "type": [
              "string",
              "null"
            ]
          },
          "internalSku": {
            "type": [
              "string",
              "null"
            ]
          },
          "mappingStatus": {
            "type": "string",
            "enum": [
              "UNMAPPED",
              "SUGGESTED",
              "VERIFIED",
              "ACTIVE",
              "CONFLICT",
              "SUPERSEDED"
            ]
          },
          "sourceUpdatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastSyncedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "completeness": {
            "type": "string",
            "enum": [
              "COMPLETE_KNOWN",
              "PARTIAL",
              "UNAVAILABLE",
              "STALE",
              "DISPUTED",
              "NOT_CALCULABLE"
            ]
          }
        }
      },
      "Order": {
        "type": "object",
        "required": [
          "id",
          "externalOrderId",
          "fulfillmentStatus",
          "refundStatus",
          "financialStatus",
          "amount",
          "completeness"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "externalOrderId": {
            "type": "string"
          },
          "marketplaceId": {
            "type": "string"
          },
          "fulfillmentStatus": {
            "type": "string"
          },
          "refundStatus": {
            "type": "string",
            "enum": [
              "NONE",
              "PARTIAL",
              "FULL",
              "UNKNOWN"
            ]
          },
          "financialStatus": {
            "type": "string",
            "enum": [
              "NOT_OBSERVED",
              "POSTED",
              "PARTIALLY_RECONCILED",
              "SETTLED",
              "DISPUTED"
            ]
          },
          "amount": {
            "$ref": "#/components/schemas/Money"
          },
          "sourceUpdatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastSyncedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "completeness": {
            "type": "string",
            "enum": [
              "COMPLETE_KNOWN",
              "PARTIAL",
              "UNAVAILABLE",
              "STALE",
              "DISPUTED",
              "NOT_CALCULABLE"
